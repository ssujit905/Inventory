<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- REQUIRED: Electron loads its own Framework + helper apps.
         Without this, ad-hoc / unsigned builds crash at launch with:
         "mapping process and mapped file have different Team IDs" -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required by Electron's V8 JIT compiler -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron's Node.js bindings under Hardened Runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Network access for Supabase / API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
